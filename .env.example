# Hope Theory Labs — environment variables for the site assistant.
#
# Everything here is free tier, and every value is optional: with an empty file
# the assistant still answers from the scripted knowledge base. Copy the keys
# you have into Vercel → Project → Settings → Environment Variables, tick
# Production and Preview, then redeploy. Never commit the real values.

# Groq (free) — the primary chat model. console.groq.com → API Keys.
GROQ_API_KEY=

# Google AI Studio (free) — used only when Groq rate-limits or errors.
GEMINI_API_KEY=

# Supabase (free) — saves enquiries to the `leads` table and shares the rate
# limiter across serverless instances. Use the service role key, never the anon
# key, and never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (free) — emails each new enquiry. `onboarding@resend.dev` only
# delivers to the address the Resend account was created with.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=hopetheorybd@gmail.com

# Optional. When set, the assistant shows a "Book a call" link.
NEXT_PUBLIC_CALCOM_URL=
