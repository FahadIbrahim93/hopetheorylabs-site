# Optional free-tier keys for the site assistant.
# Copy to .env.local for local runs. Set the same names in Vercel → Settings →
# Environment Variables (Production and Preview). Never commit real values.

# Groq (free) — first model in the chain. If unset, falls through to Gemini.
GROQ_API_KEY=

# Google AI Studio / Gemini (free) — second model. If unset, the scripted FAQ
# answers every question. Leave empty if you only want FAQ replies.
# The key is sent as a query parameter (Google's documented pattern for this API).
GEMINI_API_KEY=

# Supabase (free) — saves enquiries to the `leads` table and shares the rate
# limiter across serverless instances. Use the service role key, never the anon
# key, and never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (free) — emails each new enquiry. `onboarding@resend.dev` only
# delivers to the address the Resend account was created with.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=hopetheorybd@gmail.com

# Optional. When set, the assistant shows a "Book a call" link.
NEXT_PUBLIC_CALCOM_URL=
